{
  "expo": {
    "name": "Кудайберген",
    "slug": "kudaibergen-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kudaibergenv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Найдём мастеров рядом, когда вы отправляете заявку, и покажем дорогу к магазину.",
        "NSMicrophoneUsageDescription": "Скажите голосом, какая запчасть нужна или что случилось с машиной, и отправляйте голосовые в чате.",
        "NSPhotoLibraryUsageDescription": "Прикрепите фото или видео запчасти к запросу, товару или сообщению.",
        "NSCameraUsageDescription": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям."
      },
      "bundleIdentifier": "kg.kudaibergen.app",
      "associatedDomains": [
        "applinks:kudaibergen.kg"
      ],
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "package": "kg.kudaibergen.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/qr/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/m/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Скажите голосом, какая запчасть нужна или что случилось с машиной, и отправляйте голосовые в чате."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям.",
          "microphonePermission": "Запишите видео запчасти со звуком.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Найдём мастеров рядом, когда вы отправляете заявку, и покажем дорогу к магазину."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Прикрепите фото или видео запчасти к запросу, товару или сообщению.",
          "cameraPermission": "Сфотографируйте или снимите видео запчасти, чтобы показать продавцу или покупателям.",
          "microphonePermission": "Запишите видео запчасти со звуком."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
