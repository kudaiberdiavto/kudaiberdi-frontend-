{
  "expo": {
    "name": "kudaibergen-v2",
    "slug": "kudaibergen-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kudaibergenv2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Покажем, где вы на схеме рынка, и построим путь к боксу."
      },
      "bundleIdentifier": "com.bekturillo.kudaibergenv2",
      "associatedDomains": [
        "applinks:kudaibergen.kg"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ],
      "package": "com.bekturillo.kudaibergenv2",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/qr/"
            },
            {
              "scheme": "https",
              "host": "kudaibergen.kg",
              "pathPrefix": "/m/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1115",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-secure-store",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Сфотографируйте запчасть, чтобы показать её покупателям."
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Покажем мастерам, куда ехать — только когда вы отправляете заявку."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
