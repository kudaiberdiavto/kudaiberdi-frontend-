{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kudaibergen.kg",
        "EXPO_PUBLIC_CENTRIFUGO_URL": "wss://rt.kudaibergen.kg/connection/websocket"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.kudaibergen.kg",
        "EXPO_PUBLIC_CENTRIFUGO_URL": "wss://rt.kudaibergen.kg/connection/websocket"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
