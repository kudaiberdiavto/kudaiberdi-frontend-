# Backend addresses. Leave empty in development: the app talks to the machine
# that runs Metro (its current IP), so the simulator and a phone on the same
# Wi-Fi work without edits. Set them for staging / production builds, e.g.
#   EXPO_PUBLIC_API_URL=https://api.kudaibergen.kg
#   EXPO_PUBLIC_CENTRIFUGO_URL=wss://rt.kudaibergen.kg/connection/websocket
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CENTRIFUGO_URL=
